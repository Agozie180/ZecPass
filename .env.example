# ZecPass environment: copy to `.env.local`.
# All values are public (NEXT_PUBLIC_*). There are no secrets and no private keys.

# "testnet" (default) or "mainnet". Controls which address prefixes are accepted
# (utest1/ztestsapling1 vs u1/zs1), which seed and board storage are used, and is
# mixed into each auction's commitment tag. It is read at build time, so change
# it before `npm run build`. The live demo runs mainnet; local development stays
# on testnet so it never touches real funds.
NEXT_PUBLIC_ZCASH_NETWORK=testnet
